# Copy to .env and adjust. Never commit .env.
# All values are optional; defaults are shown.

KYARA_BASE_URL=https://kyara.games

# Session, settings, monitors, bridge pairings, action journal, catalogue cache and the
# CLI's browser profile. Git-ignored; keep it private.
KYARA_DATA_DIR=.kyara

# Overrides the stored session (normally from the app, the extension or `kyara session login`).
# Never written to disk.
# KYARA_TOKEN=<paste-your-token-here>

KYARA_TIMEOUT_MS=15000
# Retries apply to read requests only.
KYARA_MAX_RETRIES=3
# Minimum delay between two requests (ms). Keep this conservative.
KYARA_MIN_INTERVAL_MS=250

# Bot browser (CLI only). `session login` refuses to run headless: logging in needs a visible window.
KYARA_HEADLESS=false

# debug | info | warn | error
KYARA_LOG_LEVEL=info

# Spending limits (chakra). These are normally set in the app (Settings); a value set here
# overrides the app and shows as locked there.
KYARA_MAX_SPEND_PER_ACTION=500
KYARA_AUTO_BID_ENABLED=false
KYARA_AUTO_BID_BUDGET=0
KYARA_AUTO_BID_MAX=0
# Trade monitors only send trades when this is true; otherwise they stay in preview.
# The budget caps chakra committed in pending proposals; 0 = card-for-card trades only.
KYARA_AUTO_TRADE_ENABLED=false
KYARA_AUTO_TRADE_BUDGET=0
